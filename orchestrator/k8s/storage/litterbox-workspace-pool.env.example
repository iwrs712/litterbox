# Name exposed to Kubernetes and referenced by [workspace].storage_class.
LITTERBOX_WORKSPACE_STORAGE_CLASS=litterbox-workspace-lvm

# LVM volume group used by the OpenEBS LocalPV-LVM CSI driver.
LITTERBOX_WORKSPACE_VG=litterbox-workspace-vg

# Use a file-backed loop device until a dedicated disk is available.
LITTERBOX_WORKSPACE_BACKING_FILE=/var/lib/litterbox-workspace-pool/workspaces.img
LITTERBOX_WORKSPACE_POOL_SIZE=20G

# Set this instead of LITTERBOX_WORKSPACE_BACKING_FILE when a dedicated block
# device is available. Do not set both.
# LITTERBOX_WORKSPACE_BLOCK_DEVICE=/dev/nvme1n1
